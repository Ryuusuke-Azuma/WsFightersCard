<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 15+ (API 35+) theme: Deprecated statusBarColor/navigationBarColor removed for Edge-to-Edge compliance -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main Palette -->
        <item name="colorPrimary">@color/brand_charcoal</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/gray_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- UI Surfaces -->
        <item name="android:windowBackground">@color/brand_bg_light</item>
        <!-- statusBarColor and navigationBarColor are REMOVED here to fix the deprecation warning -->

        <!-- Surface & Card Colors -->
        <item name="colorSurface">@color/brand_surface_white</item>
        <item name="colorOnSurface">@color/brand_charcoal</item>
        <item name="colorSurfaceVariant">@color/brand_divider</item>
        <item name="colorOnSurfaceVariant">@color/brand_grey_text</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/brand_charcoal</item>
        <item name="android:textColorSecondary">@color/brand_grey_text</item>

        <!-- Status Bar Appearance -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Edge-to-Edge Compatibility -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>

        <!-- Toolbar customization -->
        <item name="toolbarStyle">@style/AppTheme.Toolbar</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- statusBarColor removed -->
    </style>

</resources>
